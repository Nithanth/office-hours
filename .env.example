# === API keys ===
# EXA_API_KEY is required. At least one LLM provider key is also required.
EXA_API_KEY="your_exa_key_here"
GEMINI_API_KEY="your_google_gemini_key_here"
ANTHROPIC_API_KEY="your_anthropic_key_here_sk-ant-..."
OPENAI_API_KEY="your_openai_key_here_sk-..."
TOGETHER_API_KEY="your_together_key_here"

# === Deployment ===
ENV=dev
PORT=8000
LOG_LEVEL=info

# ---- Performance / cost optimisation flags ----
# Set to "1" to store float16 embeddings (≈50% smaller)
EMB_FLOAT16=1
# Override batch size for SentenceTransformer.encode during indexing
EMB_BATCH_SIZE=128
# Persist query embeddings on disk between restarts
DISK_QUERY_CACHE=1
# Use HTTP conditional requests to skip re-downloading unchanged PDFs
USE_COND_FETCH=1
