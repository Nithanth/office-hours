# API Keys
EXA_API_KEY="your_exa_key_here"
TOGETHER_API_KEY="your_together_key_here"
OPENAI_API_KEY="your_openai_key_here_sk-..."
ANTHROPIC_API_KEY="your_anthropic_key_here_sk-ant-..."
GEMINI_API_KEY="your_google_gemini_key_here"
# GOOGLE_DOCS_CREDENTIALS_PATH="./google_credentials.json" # Deferred for MVP

# Redis Configuration
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SEARCH=86400
CACHE_TTL_PAPER=604800

# Modal Configuration
MODAL_TOKEN="your_modal_token_here"
MODAL_WORKSPACE="your_modal_workspace_name_here"

# Application Settings
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# LLM Configuration - See config.py for defaults if not set here
DEFAULT_LLM_PROVIDER="together_ai" # Options: together_ai, openai, anthropic, gemini
TOGETHER_DEFAULT_MODEL="meta-llama/Llama-3-70b-chat-hf"
OPENAI_DEFAULT_MODEL="gpt-4o"
ANTHROPIC_DEFAULT_MODEL="claude-3-opus-20240229"
GEMINI_DEFAULT_MODEL="gemini-1.5-pro-latest"
LLM_TEMPERATURE=0.7
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Deployment
# Set ENV=prod to serve optimised PurgeCSS bundle (static/css/dist/*)
# Optionally override CSS_PREFIX directly.
ENV=dev
# CSS_PREFIX=css/dist
