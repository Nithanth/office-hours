# === API keys ===
# EXA_API_KEY and OPENROUTER_API_KEY are required. All models route through
# OpenRouter (fast/standard/deep tiers); the other provider keys below are
# optional legacy fallbacks used only by niche paths (e.g. vision figures).
EXA_API_KEY="your_exa_key_here"
# Optional: raises Semantic Scholar rate limits for author search/profile.
# Without it the shared unauthenticated pool 429s often. Apply (free) at
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=""
GEMINI_API_KEY="your_google_gemini_key_here"
ANTHROPIC_API_KEY="your_anthropic_key_here_sk-ant-..."
OPENAI_API_KEY="your_openai_key_here_sk-..."
TOGETHER_API_KEY="your_together_key_here"
XAI_API_KEY="your_xai_key_here"
# Primary LLM gateway. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY="your_openrouter_key_here_sk-or-..."
# Optional: override the pinned tier model IDs (OpenRouter author/slug format).
# OPENROUTER_MODEL_FAST="google/gemini-3.5-flash"
# OPENROUTER_MODEL_STANDARD="anthropic/claude-sonnet-4.6"
# OPENROUTER_MODEL_DEEP="google/gemini-3.1-pro-preview"

# === Notion export (optional) ===
# Create an internal integration at https://www.notion.so/profile/integrations
# then share the parent page/database with the integration.
NOTION_API_KEY=""
# Either set a parent page ID (reports become child pages)...
NOTION_PARENT_PAGE_ID=""
# ...or a database ID (reports become rows with typed properties).
NOTION_PARENT_DATABASE_ID=""

# === Private beta SaaS spine ===
# Postgres is required for durable users, report history, per-user Notion, and quotas.
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/office_hours"
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OH_SECRET_ENCRYPTION_KEY=""
AUTH_REDIRECT_BASE_URL="http://localhost:8000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NOTION_OAUTH_CLIENT_ID=""
NOTION_OAUTH_CLIENT_SECRET=""
REQUIRE_LOGIN=0
BETA_DAILY_REPORT_LIMIT=20
BETA_DAILY_SEARCH_LIMIT=100

# === Deployment ===
ENV=dev
PORT=8000
LOG_LEVEL=info

# ---- Performance / cost optimisation flags ----
# Set to "1" to store float16 embeddings (≈50% smaller)
EMB_FLOAT16=1
# Override batch size for SentenceTransformer.encode during indexing
EMB_BATCH_SIZE=128
# Persist query embeddings on disk between restarts
DISK_QUERY_CACHE=1
# Use HTTP conditional requests to skip re-downloading unchanged PDFs
USE_COND_FETCH=1
