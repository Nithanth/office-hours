# pyenv
.python-version

# pipenv
#   According to Pipenv's documentation, it is recommended to include Pipfile.lock
#   in version control. But in case you prefer not to, then uncomment the following
#   line:
#Pipfile.lock

# poetry
#   Similar to Pipenv, it is recommended to include poetry.lock in version control.
#   This file is essential for deterministic builds.
#poetry.lock

# pdm
#   Similar to Pipenv, it is recommended to include pdm.lock in version control.
#pdm.lock

# PEP 582; used by e.g. pdm
__pypackages__/

